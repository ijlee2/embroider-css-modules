{
  "name": "my-v2-app",
  "version": "1.5.2",
  "private": true,
  "description": "An Ember app with embroider-css-modules and Vite",
  "keywords": [
    "css",
    "css-modules",
    "emberjs",
    "embroider",
    "glint",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ijlee2/embroider-css-modules.git"
  },
  "license": "MIT",
  "author": "Isaac J. Lee",
  "exports": {
    "./tests/*": "./tests/*",
    "./*": "./app/*"
  },
  "scripts": {
    "build": "vite build",
    "build:test": "NODE_ENV=development vite build --config vite.test.config.mts --mode development",
    "format": "prettier . --cache --write",
    "lint": "concurrently \"pnpm:lint:*(!fix)\" --names \"lint:\"",
    "lint:css": "stylelint \"app/**/*.css\" --cache",
    "lint:css:fix": "stylelint \"app/**/*.css\" --fix",
    "lint:fix": "concurrently \"pnpm:lint:*:fix\" --names \"fix:\" && pnpm format",
    "lint:format": "prettier . --cache --check",
    "lint:js": "eslint . --cache",
    "lint:js:fix": "eslint . --fix",
    "prelint:types": "type-css-modules --src app",
    "lint:types": "ember-tsc --noEmit",
    "start": "vite",
    "test": "pnpm build:test && ember-test --port 0",
    "test:watch": "concurrently \"pnpm build:test --watch\" && \"pnpm ember-test --server\" --names build,test"
  },
  "devDependencies": {
    "@babel/core": "^8.1.2",
    "@babel/plugin-transform-runtime": "^8.1.2",
    "@babel/plugin-transform-typescript": "^8.0.6",
    "@ember/optional-features": "^3.0.0",
    "@ember/string": "^4.0.1",
    "@ember/test-helpers": "^5.8.0",
    "@embroider/compat": "^4.1.28",
    "@embroider/config-meta-loader": "^1.0.1",
    "@embroider/core": "^4.6.10",
    "@embroider/router": "^3.0.6",
    "@embroider/vite": "^1.8.0",
    "@glimmer/component": "^2.2.1",
    "@glimmer/tracking": "^1.1.2",
    "@glint/ember-tsc": "^1.14.3",
    "@glint/template": "^1.11.1",
    "@glint/tsserver-plugin": "^2.7.16",
    "@rollup/plugin-babel": "^7.1.0",
    "@shared-configs/eslint-config-ember": "workspace:*",
    "@shared-configs/prettier": "workspace:*",
    "@shared-configs/stylelint": "workspace:*",
    "@shared-configs/testem": "workspace:*",
    "@shared-configs/typescript": "workspace:*",
    "@types/qunit": "^2.19.14",
    "babel-plugin-ember-template-compilation": "^4.0.1",
    "broccoli-asset-rev": "^3.0.0",
    "concurrently": "^10.0.7",
    "decorator-transforms": "^2.4.0",
    "ember-cli": "~7.4.0",
    "ember-cli-app-version": "^7.0.0",
    "ember-load-initializers": "^3.0.1",
    "ember-modifier": "^4.3.0",
    "ember-page-title": "^9.1.0",
    "ember-qunit": "^9.2.0",
    "ember-resolver": "^13.2.0",
    "ember-source": "~7.4.0",
    "ember-testem": "^1.0.0",
    "embroider-css-modules": "workspace:*",
    "eslint": "^10.15.0",
    "lightningcss": "^1.33.0",
    "prettier": "^3.10.1",
    "qunit": "^3.0.0",
    "qunit-dom": "^3.6.0",
    "strip-test-selectors": "^0.1.0",
    "stylelint": "^18.0.0",
    "type-css-modules": "workspace:*",
    "typescript": "^6.0.3",
    "vite": "^8.3.8"
  },
  "engines": {
    "node": "22.* || >= 24"
  },
  "ember": {
    "edition": "octane"
  },
  "ember-addon": {
    "type": "app",
    "version": 2
  }
}
